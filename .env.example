# Copy to .env for local invitation-mode testing. Do not commit .env.
TAROT_MODE=hosted
APP_ORIGIN=http://127.0.0.1:3000
TAROT_API_BASE_URL=https://api.deepseek.com
TAROT_API_KEY=
TAROT_MODEL=deepseek-v4-pro
# Run npm run create-secrets and copy the generated values below.
TAROT_INVITE_CODES=[]
TAROT_SESSION_SECRET=
# Vercel + Neon: set DATABASE_URL and APP_ORIGIN to the production HTTPS URL.
# DATABASE_URL=postgresql://user:password@your-pooler-host/neondb?sslmode=verify-full
# Without DATABASE_URL, standalone/Render deployments use this file:
TAROT_USAGE_FILE=./.data/usage.json
TAROT_INVITE_DAILY_LIMIT=5
TAROT_INVITE_TOTAL_LIMIT=20
TAROT_DAILY_LIMIT=100
TAROT_TOTAL_LIMIT=1000
TAROT_REQUESTS_PER_MINUTE=2
TAROT_CONCURRENT_LIMIT=3
TAROT_MAX_INPUT_CHARS=20000
TAROT_MAX_OUTPUT_TOKENS=2048
